# Used by docker-compose.yml to configure the Postgres container and the
# backend's DATABASE_URL. Copy this to .env (gitignored) and fill in real
# values before running `docker compose up`.

POSTGRES_USER=cybersaathi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cybersaathi

# Secret used to sign JWTs — generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-secret
